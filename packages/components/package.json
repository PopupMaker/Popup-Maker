{
  "name": "@popup-maker/components",
  "version": "1.0.1",
  "description": "Popup Maker Components",
  "author": "Code Atlantic",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "popup-maker"
  ],
  "homepage": "https://github.com/popupmaker/popup-maker/tree/trunk/packages/components/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popupmaker/popup-maker.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/popupmaker/popup-maker/issues"
  },
  "main": "build/index.js",
  "types": "build-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./build-types/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "wpScript": true,
  "dependencies": {
    "@popup-maker/core-data": "workspace:*",
    "@popup-maker/i18n": "workspace:*",
    "@popup-maker/skeleton": "workspace:*",
    "@popup-maker/utils": "workspace:*",
    "@wordpress/base-styles": "^12.0.0",
    "@wordpress/components": "^38.0.0",
    "@wordpress/compose": "^8.5.0",
    "@wordpress/core-data": "^7.52.0",
    "@wordpress/data": "^10.52.0",
    "@wordpress/element": "^8.4.0",
    "@wordpress/html-entities": "^4.52.0",
    "@wordpress/icons": "^15.3.0",
    "@wordpress/keycodes": "^4.52.0",
    "@wordpress/url": "^4.52.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@popup-maker/types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "scripts": {
    "prepack": "pnpm run build:tsc && pnpm run build:types",
    "build:tsc": "tsc",
    "build:types": "tsc --build",
    "watch:tsc": "tsc -w",
    "clean": "rimraf build build-types tsconfig.tsbuildinfo",
    "lint": "wp-scripts lint-js .",
    "format": "wp-scripts lint-js . --fix",
    "packages-update": "wp-scripts packages-update"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "build-types",
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ]
}
