{
	"name": "@popup-maker/skeleton",
	"version": "1.0.0",
	"description": "Loading skeleton primitives for Popup Maker admin UI",
	"author": "Code Atlantic",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"popup-maker"
	],
	"homepage": "https://github.com/popupmaker/popup-maker/tree/trunk/packages/skeleton/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/popupmaker/popup-maker.git",
		"directory": "packages/skeleton"
	},
	"bugs": {
		"url": "https://github.com/popupmaker/popup-maker/issues"
	},
	"files": [
		"build",
		"build-types",
		"src",
		"tsconfig.json",
		"README.md",
		"LICENSE"
	],
	"main": "build/index.js",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"wpScript": true,
	"types": "build-types/index.d.ts",
	"sideEffects": [
		"*.scss",
		"*.css"
	],
	"dependencies": {
		"@wordpress/components": "^38.0.0",
		"@wordpress/element": "^8.5.0"
	},
	"peerDependencies": {
		"react": "^18.3.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "pnpm run build:tsc && pnpm run build:types",
		"build:tsc": "tsc",
		"build:types": "tsc --build",
		"watch:tsc": "tsc -w",
		"clean": "rimraf build build-types tsconfig.tsbuildinfo",
		"lint": "wp-scripts lint-js .",
		"format": "wp-scripts lint-js . --fix",
		"packages-update": "wp-scripts packages-update"
	}
}
