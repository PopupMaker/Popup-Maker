{
	"name": "@popup-maker/admin-notifications",
	"version": "1.0.0",
	"description": "Popup Maker admin notifications panel — toolbar-triggered slide-in panel powered by pum_alert_list.",
	"author": "Code Atlantic",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"wordpress",
		"popup-maker",
		"notifications"
	],
	"homepage": "https://github.com/popupmaker/popup-maker/tree/trunk/packages/admin-notifications/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/popupmaker/popup-maker.git",
		"directory": "packages/admin-notifications"
	},
	"bugs": {
		"url": "https://github.com/popupmaker/popup-maker/issues"
	},
	"main": "build/index.js",
	"types": "build-types/index.d.ts",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"wpScript": true,
	"dependencies": {
		"@popup-maker/i18n": "workspace:*",
		"@popup-maker/icons": "workspace:*",
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/dom-ready": "^4.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/hooks": "^4.52.0",
		"clsx": "^2.1.1"
	},
	"scripts": {
		"build:tsc": "tsc",
		"build:types": "tsc --build",
		"watch:tsc": "tsc -w",
		"clean": "rimraf build build-types tsconfig.tsbuildinfo",
		"lint": "wp-scripts lint-js .",
		"format": "wp-scripts lint-js . --fix",
		"packages-update": "wp-scripts packages-update"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"files": [
		"build",
		"build-types",
		"tsconfig.json"
	]
}
