{
	"name": "@popup-maker/builder-preview",
	"version": "1.0.0",
	"description": "Popup Maker page builder canvas preview",
	"author": "Code Atlantic",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"wordpress",
		"popup-maker",
		"page-builder"
	],
	"homepage": "https://github.com/popupmaker/popup-maker/tree/trunk/packages/builder-preview",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/popupmaker/popup-maker.git",
		"directory": "packages/builder-preview"
	},
	"bugs": {
		"url": "https://github.com/popupmaker/popup-maker/issues"
	},
	"main": "build/index.js",
	"types": "build-types/index.d.ts",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"peerDependencies": {
		"jquery": "^3.5.32"
	},
	"devDependencies": {
		"@types/jquery": "^4.0.1"
	},
	"scripts": {
		"build:tsc": "tsc",
		"build:types": "tsc --build",
		"watch:tsc": "tsc -w",
		"clean": "rimraf build build-types tsconfig.tsbuildinfo",
		"lint": "wp-scripts lint-js .",
		"format": "wp-scripts lint-js . --fix"
	},
	"files": [
		"build",
		"build-types",
		"tsconfig.json"
	]
}
