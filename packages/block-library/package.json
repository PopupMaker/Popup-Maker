{
	"name": "@popup-maker/block-library",
	"version": "1.0.0",
	"description": "Popup Maker Block Library",
	"author": "Code Atlantic",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"wordpress",
		"popup-maker"
	],
	"homepage": "https://github.com/popupmaker/popup-maker/tree/trunk/packages/block-library/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/popupmaker/popup-maker.git",
		"directory": "packages/block-library"
	},
	"bugs": {
		"url": "https://github.com/popupmaker/popup-maker/issues"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"main": "build/index",
	"types": "build-types",
	"react-native": "src/index",
	"dependencies": {
		"@popup-maker/components": "workspace:*",
		"@popup-maker/core-data": "workspace:*",
		"@popup-maker/cta-editor": "workspace:*",
		"@popup-maker/i18n": "workspace:*",
		"@popup-maker/icons": "workspace:*",
		"@wordpress/blob": "^4.54.0",
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/blocks": "^15.27.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/compose": "^8.7.0",
		"@wordpress/core-data": "^7.54.0",
		"@wordpress/data": "^10.54.0",
		"@wordpress/dom-ready": "^4.54.0",
		"@wordpress/edit-post": "^8.54.0",
		"@wordpress/editor": "^14.54.0",
		"@wordpress/element": "^8.6.0",
		"@wordpress/hooks": "^4.54.0",
		"@wordpress/html-entities": "^4.54.0",
		"@wordpress/icons": "^15.5.0",
		"@wordpress/keycodes": "^4.54.0",
		"@wordpress/rich-text": "^7.54.0",
		"clsx": "^2.1.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.1"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-native": "^0.76.5"
	},
	"scripts": {
		"build:tsc": "tsc",
		"build:types": "tsc --build",
		"watch:tsc": "tsc -w",
		"clean": "rimraf build build-types tsconfig.tsbuildinfo",
		"lint": "wp-scripts lint-js .",
		"format": "wp-scripts lint-js . --fix",
		"packages-update": "wp-scripts packages-update"
	}
}
