{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"allowSyntheticDefaultImports": true,
		"jsx": "preserve",
		"target": "esnext",
		"module": "esnext",
		"lib": [ "dom", "esnext" ],
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"emitDeclarationOnly": false,
		"isolatedModules": true,
		/* Strict Type-Checking Options */
		"strict": true,
		/* This is done on a per package basis currently. */
		"noImplicitAny": false,
		/* Additional Checks */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		// "importsNotUsedAsValues": "error",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		/* Module Resolution Options */
		/* "node" is deprecated in TS 5.x (renamed to "node10"). Switching
		   to "bundler" is the long-term fix but breaks type-root resolution
		   in this monorepo (hoisted @types/* aren't found from package
		   dirs). Silence the deprecation until TS 7.0 ships and a full
		   migration to bundler/node16 can be done as its own task. */
		"moduleResolution": "node",
		"ignoreDeprecations": "5.0",
		/* This needs to be false so our types are possible to consume without setting this */
		"esModuleInterop": false,
		"resolveJsonModule": true,
		"strictNullChecks": true,
		/* Opt-in ambient types only. Empty list disables TS's default
		   "include every @types/* reachable from node_modules" behaviour,
		   which in a pnpm-hoisted monorepo pulls in type packages whose
		   peer deps aren't present in each package (e.g. jest-dom types
		   fail to resolve from `@popup-maker/types`). Packages that need
		   globals like jquery declare them in their own tsconfig. */
		"types": []
	},
	"exclude": [
		"node_modules",
		"**/node_modules/*",
		"build",
		"dist",
		"build-types",
		"**/*.js",
		"**/assets/**",
		"**/build/**",
		"**/dist/**",
		"**/vendor/**",
		"**/test/**",
		"**/__tests__/**",
		"**/*.test.ts",
		"**/*.test.tsx"
	]
}
