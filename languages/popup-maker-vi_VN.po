msgid "Popup Content"
msgstr "Nội dung popup"

#: classes/Admin/Onboarding.php:218
msgid "Add content for your popup here."
msgstr "Thêm nội dung cho popup của bạn tại đây."

#: classes/Admin/Onboarding.php:231
