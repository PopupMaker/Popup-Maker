msgstr "Kích hoạt popup"

#: classes/Admin/Onboarding.php:232
msgid "Use triggers to choose  what causes the popup to open."
msgstr "Dùng các trình kích hoạt để chọn điều gì khiến popup mở ra."

#: classes/Admin/Onboarding.php:245
msgid "Popup Targeting"
msgstr "Nhắm mục tiêu popup"

#: classes/Admin/Onboarding.php:246
msgid ""
"Use targeting to choose where on your site the popup should load and who to "
"show the popup to."
msgstr ""
"Dùng tính năng nhắm mục tiêu để chọn nơi trên trang web mà popup sẽ hiển "
"thị và ai sẽ thấy popup."

#: classes/Admin/Onboarding.php:259
msgid "Popup Display"
msgstr "Hiển thị popup"

#: classes/Admin/Onboarding.php:260
msgid ""
"Use display settings to choose where on the screen the popup appears and "
"what it looks like."
msgstr ""
"Dùng cài đặt hiển thị để chọn vị trí popup xuất hiện trên màn hình và giao "
"diện của nó."

