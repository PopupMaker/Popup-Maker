{"translation-revision-date":"2026-08-06 02:06+0000","generator":"WP-CLI\/2.12.0","source":"dist\/packages\/block-editor.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hi-IN","plural-forms":"nplurals=2; plural=(n != 1);"},"Popup Title":["\u092a\u0949\u092a\u0905\u092a \u0936\u0940\u0930\u094d\u0937\u0915"],"Title":["\u0936\u0940\u0930\u094d\u0937\u0915"],"Open Popup":["\u092a\u0949\u092a\u0905\u092a \u0916\u094b\u0932\u0947\u0902"],"Popup Trigger":["\u092a\u0949\u092a\u0905\u092a \u091f\u094d\u0930\u093f\u0917\u0930"],"Popup Controls":["\u092a\u0949\u092a\u0905\u092a \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923"],"These settings allow you to control popups with this block.":["\u092f\u0947 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0906\u092a\u0915\u094b \u0907\u0938 \u092c\u094d\u0932\u0949\u0915 \u0915\u0947 \u0938\u093e\u0925 \u092a\u0949\u092a\u0905\u092a \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964"],"This method does not work well with all block types.":["\u092f\u0939 \u0924\u0930\u0940\u0915\u093e \u0938\u092d\u0940 \u092c\u094d\u0932\u0949\u0915 \u092a\u094d\u0930\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"],"Open documentation":["\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u0940\u0915\u0930\u0923 \u0916\u094b\u0932\u0947\u0902"],"Open a popup when clicking this block":["\u0907\u0938 \u092c\u094d\u0932\u0949\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u0947 \u092a\u0930 \u092a\u0949\u092a\u0905\u092a \u0916\u094b\u0932\u0947\u0902"],"Popup Trigger Editor":["\u092a\u0949\u092a\u0905\u092a \u091f\u094d\u0930\u093f\u0917\u0930 \u0938\u0902\u092a\u093e\u0926\u0915"],"Popup Selection Controls":["\u092a\u0949\u092a\u0905\u092a \u091a\u092f\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923"],"Which popup should open?":["\u0915\u094c\u0928 \u0938\u093e \u092a\u0949\u092a\u0905\u092a \u0916\u0941\u0932\u0928\u093e \u091a\u093e\u0939\u093f\u090f?"],"Apply":["\u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902"],"Open \"%s\" popup":["\"%s\" \u092a\u0949\u092a\u0905\u092a \u0916\u094b\u0932\u0947\u0902"],"Popup Trigger Preview":["\u092a\u0949\u092a\u0905\u092a \u091f\u094d\u0930\u093f\u0917\u0930 \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928"],"Edit":["\u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902"],"Trigger removed.":["\u091f\u094d\u0930\u093f\u0917\u0930 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964"],"Trigger edited.":["\u091f\u094d\u0930\u093f\u0917\u0930 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"],"Trigger inserted.":["\u091f\u094d\u0930\u093f\u0917\u0930 \u0921\u093e\u0932\u093e \u0917\u092f\u093e\u0964"],"Trigger settings":["\u091f\u094d\u0930\u093f\u0917\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Do not prevent default click behavior":["\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0915\u094d\u0932\u093f\u0915 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u094b \u0930\u094b\u0915\u0947\u0902 \u0928\u0939\u0940\u0902"],"Remove Trigger":["\u091f\u094d\u0930\u093f\u0917\u0930 \u0939\u091f\u093e\u090f\u0901"],"Failed to save popup title.":["\u092a\u0949\u092a\u0905\u092a \u0936\u0940\u0930\u094d\u0937\u0915 \u0938\u0939\u0947\u091c\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932 \u0930\u0939\u093e\u0964"],"Shown as headline inside the popup.":["\u092a\u0949\u092a\u0905\u092a \u0915\u0947 \u0905\u0902\u0926\u0930 \u0936\u0940\u0930\u094d\u0937\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e\u0964"],"Preview Popup":["\u092a\u0949\u092a\u0905\u092a \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928"]}}}