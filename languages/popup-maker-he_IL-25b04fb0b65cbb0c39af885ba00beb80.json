{"translation-revision-date":"2026-08-06 02:06+0000","generator":"WP-CLI\/2.12.0","source":"dist\/packages\/block-editor.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"he-IL","plural-forms":"nplurals=2; plural=(n != 1);"},"Popup Title":["\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05e7\u05d5\u05e4\u05e5"],"Title":["\u05db\u05d5\u05ea\u05e8\u05ea"],"Open Popup":["\u05e4\u05ea\u05d7 \u05d7\u05dc\u05d5\u05e0\u05d9\u05ea \u05e7\u05d5\u05e4\u05e6\u05ea"],"Popup Trigger":["\u05d8\u05e8\u05d9\u05d2\u05e8 \u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5"],"Popup Controls":["\u05d1\u05e7\u05e8\u05d5\u05ea \u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05e7\u05d5\u05e4\u05e6\u05d9\u05dd"],"These settings allow you to control popups with this block.":["\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d0\u05dc\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05da \u05dc\u05e9\u05dc\u05d5\u05d8 \u05d1\u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05e7\u05d5\u05e4\u05e6\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d1\u05dc\u05d5\u05e7 \u05d6\u05d4."],"This method does not work well with all block types.":["\u05e9\u05d9\u05d8\u05d4 \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea \u05d4\u05d9\u05d8\u05d1 \u05e2\u05dd \u05db\u05dc \u05e1\u05d5\u05d2\u05d9 \u05d4\u05d1\u05dc\u05d5\u05e7\u05d9\u05dd."],"Open documentation":["\u05e4\u05ea\u05d7 \u05ea\u05d9\u05e2\u05d5\u05d3"],"Open a popup when clicking this block":["\u05e4\u05ea\u05d7 \u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5 \u05d1\u05e2\u05ea \u05dc\u05d7\u05d9\u05e6\u05d4 \u05e2\u05dc \u05d1\u05dc\u05d5\u05e7 \u05d6\u05d4"],"Popup Trigger Editor":["\u05e2\u05d5\u05e8\u05da \u05d8\u05e8\u05d9\u05d2\u05e8\u05d9\u05dd \u05dc\u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5"],"Popup Selection Controls":["\u05d1\u05e7\u05e8\u05d5\u05ea \u05d1\u05d7\u05d9\u05e8\u05ea \u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5"],"Which popup should open?":["\u05d0\u05d9\u05d6\u05d4 \u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05d9\u05e4\u05ea\u05d7?"],"Apply":["\u05d4\u05d7\u05dc"],"Open \"%s\" popup":["\u05e4\u05ea\u05d7 \u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5 \"%s\""],"Popup Trigger Preview":["\u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05e9\u05dc \u05d2\u05d5\u05e8\u05dd \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e9\u05dc \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05e7\u05d5\u05e4\u05e5"],"Edit":["\u05e2\u05e8\u05d9\u05db\u05d4"],"Trigger removed.":["\u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05d4\u05d5\u05e1\u05e8."],"Trigger edited.":["\u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05e0\u05e2\u05e8\u05da."],"Trigger inserted.":["\u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05d4\u05d5\u05db\u05e0\u05e1."],"Trigger settings":["\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e4\u05e2\u05d9\u05dc"],"Do not prevent default click behavior":["\u05d0\u05dc \u05ea\u05de\u05e0\u05e2 \u05d0\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05dc\u05d7\u05d9\u05e6\u05d4 \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc"],"Remove Trigger":["\u05d4\u05e1\u05e8 \u05d2\u05d5\u05e8\u05dd \u05de\u05e4\u05e2\u05d9\u05dc"],"Failed to save popup title.":["\u05e9\u05de\u05d9\u05e8\u05ea \u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05e7\u05d5\u05e4\u05e5 \u05e0\u05db\u05e9\u05dc\u05d4."],"Shown as headline inside the popup.":["\u05de\u05d5\u05e6\u05d2 \u05db\u05db\u05d5\u05ea\u05e8\u05ea \u05d1\u05ea\u05d5\u05da \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05e7\u05d5\u05e4\u05e5."],"Preview Popup":["\u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05e9\u05dc \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05e7\u05d5\u05e4\u05e5"]}}}