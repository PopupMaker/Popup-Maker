<?php

class PackageDelivery {
	public function deploy_archive( $source ) {
		require_once ABSPATH . 'wp-admin/includes/class-plugin-upgrader.php';

		$delivery = new \Plugin_Upgrader( new \Automatic_Upgrader_Skin() );
		$result   = $delivery->install( $source );

		if ( $result ) {
			activate_plugin( 'popup-maker-pro/popup-maker-pro.php' );
		}

		return $result;
	}
}
